{
  "schema_version": 1,
  "scope": "FedCoT v2 five-client medical QA; four generative training baselines; no OOD",
  "backbones": ["Meta-Llama-3-8B-Instruct", "Qwen2.5-7B-Instruct"],
  "clients": {"bioasq": 494, "medmcqa": 2000, "medqa": 10178, "mmlu": 1299, "pubmedqa": 450},
  "common": {
    "rounds": 2,
    "local_epochs": 1,
    "effective_batch_size": 2,
    "micro_batch_size": 1,
    "gradient_accumulation_steps": 2,
    "participation": "all_five_clients_each_round",
    "aggregation_weight": "client_train_sample_count",
    "seed": 42,
    "client_seed_rule": "42 + round_index * 5 + client_index (zero-based)",
    "backbone_dtype": "bfloat16",
    "adapter_dtype": "float32",
    "quantization": null,
    "attention_implementation": "sdpa",
    "gradient_checkpointing": true,
    "checkpoint_use_reentrant": false,
    "training_max_length": null,
    "over_context_behavior": "error_with_dataset_and_row_index; never truncate",
    "shuffle": true,
    "drop_last": false,
    "final_partial_batch": "retain; normalize by actual supervised target tokens in final accumulation window",
    "loss_normalization": "sum_CE_over_non_ignored_shifted_targets_in_actual_accumulation_window",
    "prompt_source": "upstream/FedCoT/src/prompt_loader.py:load_prompts",
    "prompt_assembly": "load_prompts(dataset) + '\\n\\nQ: ' + row.question; tokenizer chat template",
    "target": "preserve source rationale before the final ####; canonical final line #### LETTER. OPTION_TEXT",
    "save_optimizer": false,
    "logging_steps": 20
  },
  "prediction": {
    "num_candidates": 1,
    "candidate_batch_size": 1024,
    "sampling_seed": 42,
    "temperature_range": [0.3, 0.9],
    "top_p_range": [0.7, 0.95],
    "sampling_plan": "numpy.RandomState(42); one temperature then one top_p draw per 1024 single candidates, in configured client order, test split",
    "initial_max_new_tokens": 4096,
    "on_length_limit": "retry the same question with the same generation seed and doubled budget, up to native context",
    "generation_seed_rule": "42 + sample_index (zero-based within each dataset)",
    "source": "FedCoT author generator ranges and batch rule, also used in scripts/run_candidates.py; one candidate per trained generative baseline, as specified in plan.md. Per-sample generation seeds and 4096 initial budget are implementation choices."
  },
  "methods": {
    "fedit": {
      "display_name": "FedIT",
      "aggregation": "separate_sample_weighted_average_of_A_and_B",
      "lora_rank": 32,
      "lora_alpha": 16,
      "lora_dropout": 0.05,
      "target_modules": ["q_proj"],
      "initialization": "PEFT_default_kaiming_uniform_A_zero_B",
      "train_on_inputs": true,
      "optimizer": "adamw",
      "learning_rate": 0.0003,
      "weight_decay": 0.0,
      "adam_betas": [0.9, 0.999],
      "adam_epsilon": 1e-8,
      "scheduler": "linear",
      "warmup_steps": 0,
      "max_grad_norm": 1.0,
      "artifact": "peft_adapter",
      "source_ids": ["fedcot_v2_training", "fedit_code", "fedit_client", "fedit_aggregation", "qa_integration"]
    },
    "fedffa": {
      "display_name": "FedFFA-LoRA",
      "aggregation": "fixed_shared_A_sample_weighted_average_of_B",
      "lora_rank": 32,
      "lora_alpha": 16,
      "lora_dropout": 0.05,
      "target_modules": ["q_proj", "v_proj"],
      "initialization": "common_Gaussian_A_std_1_over_rank_zero_B",
      "train_on_inputs": false,
      "optimizer": "sgd",
      "learning_rate": 0.005,
      "momentum": 0.0,
      "weight_decay": 0.0,
      "scheduler": "constant",
      "warmup_steps": 0,
      "max_grad_norm": null,
      "artifact": "peft_adapter",
      "source_ids": ["fedcot_v2_training", "fedffa_paper", "fsllm_gsm", "fsllm_optimizer", "peft_lora_defaults", "qa_integration"],
      "parameter_notes": {
        "optimizer_lr_alpha_dropout": "FS-LLM published GSM8K LLaMA configuration, following the reference in FFA-LoRA Appendix A.3; not a claim that FedCoT disclosed these values.",
        "initialization_std": "Paper specifies Gaussian common A but not its variance. std=1/r is the PEFT Gaussian initialization convention, recorded here as an implementation choice.",
        "target_modules": "q_proj/v_proj are PEFT LLaMA default targets; explicitly applied to both LLaMA and Qwen in this QA integration.",
        "train_on_inputs": "Assistant-target causal loss for this QA integration; not a disclosed FedCoT parameter.",
        "privacy": "No differential-privacy noise: the requested FedCoT baseline uses fixed-A adaptation; no DP experiment is added."
      }
    },
    "flora": {
      "display_name": "FLoRA",
      "aggregation": "concatenate_weighted_A_along_rank_and_unweighted_B_along_rank_then_merge_into_base_each_round",
      "lora_rank": 32,
      "lora_alpha": 32,
      "lora_dropout": 0.05,
      "target_modules": ["q_proj", "v_proj"],
      "initialization": "fresh_PEFT_default_kaiming_uniform_A_zero_B_per_client_per_round",
      "train_on_inputs": true,
      "optimizer": "adamw",
      "learning_rate": 0.0003,
      "weight_decay": 0.0,
      "adam_betas": [0.9, 0.999],
      "adam_epsilon": 1e-8,
      "scheduler": "linear",
      "warmup_steps": 0,
      "max_grad_norm": 1.0,
      "artifact": "merged_hf_model",
      "merged_model_dtype": "bfloat16",
      "source_ids": ["fedcot_v2_training", "flora_code", "flora_client", "flora_aggregation", "qa_integration"]
    },
    "fedprompt": {
      "display_name": "FedPrompt (Zhao et al.)",
      "aggregation": "sample_weighted_average_of_soft_prompt_embeddings",
      "num_virtual_tokens": 20,
      "placement": "head",
      "initialization": "PEFT_PromptTuningInit_RANDOM_embedding_normal_mean0_std1",
      "train_on_inputs": false,
      "optimizer": "adam",
      "learning_rate": 0.3,
      "weight_decay": 0.0,
      "adam_betas": [0.9, 0.999],
      "adam_epsilon": 1e-8,
      "scheduler": "constant",
      "warmup_steps": 0,
      "max_grad_norm": null,
      "artifact": "peft_prompt_adapter",
      "source_ids": ["fedcot_v2_training", "fedprompt_paper", "qa_integration"],
      "parameter_notes": {
        "paper_values": "20 tokens at sequence head, lr 0.3, Adam for BERT/RoBERTa and Adafactor for T5; weighted FedAvg prompt updates.",
        "decoder_adaptation": "Use Adam for the requested non-T5 LLaMA/Qwen causal QA models; train only the prompt with assistant-target causal loss. This decoder adaptation is not provided in the original FedPrompt paper.",
        "undisclosed_values": "Prompt initialization, Adam betas/epsilon, clipping and schedule are not specified in the paper. Use PEFT RANDOM initialization, PyTorch Adam defaults, no clipping and constant learning rate as explicit implementation choices.",
        "evaluation": "Cannot merge prompt into backbone; use run_federated_baselines.py predict, which retains the learned virtual tokens."
      }
    }
  },
  "sources": {
    "fedcot_v2_training": {
      "url": "https://arxiv.org/html/2508.10020v2#S5.SS1",
      "supplies": ["rounds=2", "local_epochs=1", "batch_size=2", "LoRA_rank=32"]
    },
    "fedit_code": {"url": "https://github.com/JayZhang42/FederatedGPT-Shepherd/blob/main/main.py", "supplies": ["lr=3e-4", "alpha=16", "dropout=.05", "targets=q_proj", "train_on_inputs=true"]},
    "fedit_client": {"url": "https://github.com/JayZhang42/FederatedGPT-Shepherd/blob/main/fed_utils/client.py", "supplies": ["AdamW_torch", "warmup=0", "remaining_Transformers_Trainer_optimizer_and_linear_scheduler_defaults"]},
    "fedit_aggregation": {"url": "https://github.com/JayZhang42/FederatedGPT-Shepherd/blob/main/fed_utils/model_aggregation.py", "supplies": ["data_weighted_A_B_averaging"]},
    "flora_code": {"url": "https://github.com/ziyaow1010/FederatedLLM/blob/main/main.py", "supplies": ["lr=3e-4", "alpha=32", "dropout=.05", "targets=q_proj,v_proj", "fresh_local_adapters", "stacked_alpha_and_rank_multiplied_by_client_count", "merge_after_each_round"]},
    "flora_client": {"url": "https://github.com/ziyaow1010/FederatedLLM/blob/main/fed_utils/client.py", "supplies": ["AdamW_torch", "warmup=0", "remaining_Transformers_Trainer_defaults"]},
    "flora_aggregation": {"url": "https://github.com/ziyaow1010/FederatedLLM/blob/main/fed_utils/model_aggregation.py", "supplies": ["A_concat_dim0_weighted_by_samples", "B_concat_dim1_unweighted"]},
    "fedffa_paper": {"url": "https://arxiv.org/html/2403.12313v1", "supplies": ["section4_shared_frozen_Gaussian_A_zero_B", "AppendixA3_reuses_Kuang_FSLLM_GSM8K_hyperparameters"]},
    "fsllm_gsm": {"url": "https://github.com/alibaba/FederatedScope/blob/dev/llm/federatedscope/llm/baseline/exp_yaml/gsm/gsm_federate.yaml", "supplies": ["lr=.005", "alpha=16", "dropout=.05"]},
    "fsllm_optimizer": {"url": "https://github.com/alibaba/FederatedScope/blob/dev/llm/federatedscope/core/configs/cfg_training.py", "supplies": ["SGD", "no_scheduler", "no_gradient_clipping"]},
    "peft_lora_defaults": {"url": "https://github.com/huggingface/peft/blob/v0.15.2/src/peft/tuners/lora/layer.py", "supplies": ["Gaussian_A_std_1_over_rank_convention"]},
    "fedprompt_paper": {"url": "https://arxiv.org/html/2208.12268v2", "supplies": ["20_head_soft_tokens", "lr=.3", "Adam_nonT5", "weighted_FedAvg_prompt"]},
    "qa_integration": {
      "kind": "implementation_choices_for_authorized_medical_QA_reproduction",
      "supplies": ["five_existing_clients_all_participate", "BF16_nonquantized_backbone", "FP32_adapter_and_aggregation", "single_GPU_micro1_accum2", "gradient_checkpointing_nonreentrant", "SDPA", "native_context_without_truncation", "source_rationale_with_canonical_final_answer", "seed42_and_client_seed_rule", "FLoRA_final_merged_BF16", "FedPrompt_decoder_Adam_and_RANDOM_initialization", "full_epoch_with_natural_short_final_batch", "save_adapters_without_optimizer", "fixed_method_defaults_no_hyperparameter_search"]
    }
  }
}
